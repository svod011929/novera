{
    admin off
}

{$API_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'"
    }

    @blocked path /.env /.env.* /.git/* /.vscode/* /debug/* /vite/* /api/graphql /api/gql
    respond @blocked 404

    @backend path /api/* /health /ready
    handle @backend {
        reverse_proxy delta:8080
    }

    handle {
        root * /srv/delta-frontend
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format json
    }
}
