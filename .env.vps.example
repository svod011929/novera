# NOVERA production bootstrap. Blockchain and financial functions stay off
# until the immutable owner validates and activates an encrypted generation.
API_DOMAIN=example.com
EXPECTED_VPS_IPV4=203.0.113.10
MINIAPP_URL=https://example.com
MINIAPP_ORIGIN=https://example.com
TRUSTED_HOSTS=example.com,localhost,127.0.0.1
SUPPORT_URL=https://t.me/your_support

BOT_TOKEN_FILE=/run/secrets/bot_token
ADMIN_IDS=
OWNER_IDS=
BOT_USERNAME=NOVERA_BOT
RUN_BOT_LAUNCHER=true
RUN_BROADCAST_WORKER=true

ENVIRONMENT=production
DEMO_MODE=false
CHAIN_ENABLED=false
SIMULATE_PAYOUTS=false
BSC_CHAIN_ID=56
LIVE_MODE_ACK=false
SECURITY_AUDIT_ACK=false
LEGAL_REVIEW_ACK=false

DATABASE_PATH=/app/data/delta.sqlite3
DAILY_PROFIT_BPS=1000
PAYOUT_DAYS=20
DEPOSIT_MIN_USDT=10
DEPOSIT_MAX_USDT=100000
INVOICE_TTL_MINUTES=30
DEPOSITS_ENABLED=false
INVESTMENTS_ENABLED=false
PAYOUTS_ENABLED=false
REFERRAL_ENABLED=false

BSC_RPC_URL=
BSC_WSS_URL=
BSC_RPC_FALLBACK_URL=
TOKEN_CONTRACT=0x55d398326f99059fF775485246999027B3197955
TOKEN_SYMBOL=USDT
TOKEN_DECIMALS=18
TREASURY_ADDRESS=
CONFIRMATION_BLOCKS=12
SCAN_START_BLOCK=0
BLOCK_EXPLORER_TX_URL=https://bscscan.com/tx/{tx_hash}
MINIMUM_NATIVE_BALANCE_WEI=0
MINIMUM_TOKEN_BALANCE_USDT=0

# V10.4 safety monitor: no accounting changes; only monitoring/backups/payout guard.
SAFETY_MONITOR_ENABLED=true
SAFETY_CHECK_INTERVAL_SECONDS=30
SAFETY_STARTUP_GRACE_SECONDS=180
SAFETY_MIN_NATIVE_BALANCE_WEI=1000000000000000
SAFETY_PAYOUT_STUCK_SECONDS=900
SAFETY_WSS_STALE_SECONDS=180
SAFETY_HTTP_SCAN_STALE_SECONDS=300
SAFETY_INTEGRITY_INTERVAL_SECONDS=3600
SAFETY_BACKUP_INTERVAL_SECONDS=3600
SAFETY_BACKUP_STALE_SECONDS=10800
SAFETY_BACKUP_RETENTION_COUNT=72

RUNTIME_CONFIG_KEY_FILE=/run/secrets/runtime_config_key
SEED_PHRASE=
SEED_ACCOUNT_PATH=m/44'/60'/0'/0/0

API_HOST=0.0.0.0
API_PORT=8080
FORCE_HTTPS=true
FORWARDED_ALLOW_IPS=*
MAX_REQUEST_BYTES=65536
MUTATION_RATE_LIMIT=12
MUTATION_RATE_WINDOW_SECONDS=60
TELEGRAM_INIT_DATA_TTL_SECONDS=86400
TELEGRAM_SESSION_TTL_SECONDS=604800
LOG_LEVEL=INFO
LOG_JSON=true

# V10.5 Safe Deploy infrastructure paths. The installer sets these automatically.
GFORT_APP_IMAGE=gfort-app:current
GFORT_DATA_DIR=./data
GFORT_BACKUPS_DIR=./backups
GFORT_SECRETS_DIR=./secrets
GFORT_FRONTEND_DIR=./frontend
GFORT_CADDYFILE=./deploy/Caddyfile.vps
