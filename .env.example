# Telegram
BOT_TOKEN=replace_with_botfather_token
# BOT_TOKEN_FILE=  # optional; uncomment only when using a real file path
ADMIN_IDS=123456789
# Ops alerts: deposits + confirmed payouts to a group/supergroup (optional forum topic)
# Prefer Admin → Система UI (stored in DB). Env values are fallback when DB chat_id is empty.
# OPS_CHAT_ID=-1001234567890
# OPS_TOPIC_ID=123
# Legacy alias: LOG_CHANNEL_ID is used when OPS_CHAT_ID is empty
# LOG_CHANNEL_ID=
BOT_USERNAME=NoveraBot
MINIAPP_URL=https://bnbb.tech
MINIAPP_ORIGIN=https://bnbb.tech
SUPPORT_URL=https://t.me/your_support
RUN_BOT_LAUNCHER=true
RUN_BROADCAST_WORKER=true

# Runtime mode: keep CHAIN_ENABLED=false for local development; production installer enables mainnet
ENVIRONMENT=testnet
DEMO_MODE=true
CHAIN_ENABLED=false
SIMULATE_PAYOUTS=true
LIVE_MODE_ACK=false
SECURITY_AUDIT_ACK=false
LEGAL_REVIEW_ACK=false

# Storage and business rules
DATABASE_PATH=data/delta.sqlite3
DAILY_PROFIT_BPS=1000
PAYOUT_DAYS=20
DEPOSIT_MIN_USDT=10
DEPOSIT_MAX_USDT=100000
INVOICE_TTL_MINUTES=30

# BNB Chain testnet — fill only after demo tests pass
BSC_CHAIN_ID=56
BSC_RPC_URL=
# BSC_RPC_URL_FILE=  # optional; uncomment only when using a real file path
BSC_RPC_FALLBACK_URL=
# BSC_RPC_FALLBACK_URL_FILE=  # optional; uncomment only when using a real file path
BSC_WSS_URL=
# BSC_WSS_URL_FILE=  # optional; uncomment only when using a real file path
TOKEN_CONTRACT=
TOKEN_SYMBOL=USDT
TOKEN_DECIMALS=18
TREASURY_ADDRESS=
CONFIRMATION_BLOCKS=12
SCAN_START_BLOCK=0
BLOCK_EXPLORER_TX_URL=https://bscscan.com/tx/{tx_hash}
MINIMUM_NATIVE_BALANCE_WEI=1000000000000000
MINIMUM_TOKEN_BALANCE_USDT=1

# Choose exactly one signing method; seed is shown for compatibility with the source ZIP.
# Keep this value only in the server secret store, never in the Mini App or Telegram chat.
SEED_PHRASE=
# SEED_PHRASE_FILE=  # optional; uncomment only when using a real file path
SEED_ACCOUNT_PATH=m/44'/60'/0'/0/0
PAYOUT_PRIVATE_KEY=
# PAYOUT_PRIVATE_KEY_FILE=  # optional; uncomment only when using a real file path
# PAYOUT_KEYSTORE_PATH=  # optional; uncomment only when using a real file path
PAYOUT_KEYSTORE_PASSWORD=
# PAYOUT_KEYSTORE_PASSWORD_FILE=  # optional; uncomment only when using a real file path

API_HOST=0.0.0.0
API_PORT=8080
TRUSTED_HOSTS=localhost,127.0.0.1,api.example.com
FORCE_HTTPS=false
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_REQUEST_BYTES=65536
MUTATION_RATE_LIMIT=12
MUTATION_RATE_WINDOW_SECONDS=60
TELEGRAM_INIT_DATA_TTL_SECONDS=0
TELEGRAM_SESSION_TTL_SECONDS=604800
LOG_LEVEL=INFO
LOG_JSON=true
